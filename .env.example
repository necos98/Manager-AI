# Manager AI — Environment Configuration
# Copy to .env and uncomment lines to override defaults.

# --- Database ---
# DATABASE_URL=sqlite+aiosqlite:///data/manager_ai.db

# --- Server ---
# BACKEND_PORT=8000

# --- Embedding / RAG ---
# EMBEDDING_DRIVER=sentence_transformer   # options: sentence_transformer
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_MAX_TOKENS=500
# CHUNK_OVERLAP_TOKENS=50

# --- Encryption ---
# MANAGER_AI_SECRET_KEY=        # Fernet key for encrypting credentials. Auto-generated to data/secret.key on first start.

# --- Telegram Notifications ---
# TELEGRAM_BOT_TOKEN=           # Bot token from @BotFather — enables direct Telegram notifications
# TELEGRAM_CHAT_ID=             # Default chat/group ID to receive notifications

# --- Storage paths (absolute or relative to project root) ---
# LANCEDB_PATH=data/lancedb
# RECORDINGS_PATH=data/recordings
# CLAUDE_LIBRARY_PATH=claude_library

# --- CORS ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Testing / Workbench ---
# IS_TESTING=true           # Porta backend random, DB isolato, auto-kill
# AUTO_KILL_SECONDS=60      # Quanti secondi prima di killare i processi testing
# FRONTEND_PORT=4173        # Porta fissa per il frontend (dev + preview)
